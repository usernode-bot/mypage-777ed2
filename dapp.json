{
  "name": "MyPage",
  "icon": { "emoji": "✨" },
  "secrets": [],
  "tests": [
    { "name": "Home hero renders", "path": "/", "expectSelector": "[data-testid=home-hero]" },
    { "name": "Home template carousel shows image cards", "path": "/", "expectSelector": "[data-testid=home-carousel] .mp-tpl-tile-img img" },
    { "name": "Bottom nav renders", "path": "/", "expectSelector": "[data-testid=bottom-nav]" },
    { "name": "Templates gallery renders", "path": "/templates", "expectSelector": "[data-testid=templates]" },
    { "name": "Featured template card renders", "path": "/templates", "expectSelector": "[data-testid=featured-template] .mp-tpl-scaler .mp-section" },
    { "name": "My Pages renders", "path": "/pages", "expectSelector": "[data-testid=my-pages]" },
    { "name": "Public page renders account-less", "path": "/p/staging-demo-corner", "expectSelector": "[data-testid=page-view] .mp-footer" },
    { "name": "Full-bleed sections render", "path": "/p/staging-demo-corner", "expectSelector": ".mp-section .mp-section-content" },
    { "name": "Emoji sticker renders", "path": "/p/staging-demo-corner", "expectSelector": ".mp-sticker svg.mp-sticker-emoji" },
    { "name": "New widgets + frames render publicly", "path": "/p/staging-y2k-demo", "expectSelector": ".mp-frame-window .mpw-popup" },
    { "name": "Discover gallery renders", "path": "/directory", "expectSelector": "[data-testid=directory]" },
    { "name": "Discover search renders", "path": "/directory", "expectSelector": "#mp-dir-search" },
    { "name": "Account-less make-your-own loads", "path": "/make", "expectSelector": "[data-testid=make-start]" },
    { "name": "Theme toggle renders", "path": "/", "expectSelector": "[data-testid=theme-toggle]" },
    { "name": "Dark chrome renders on home", "path": "/?theme=dark", "expectSelector": "html.dark [data-testid=home-hero]" },
    { "name": "Public page chrome honours dark", "path": "/p/staging-demo-corner?theme=dark", "expectSelector": "html.dark [data-testid=page-view]" },
    { "name": "Editor chrome renders dark", "path": "/make?shot=editor&theme=dark", "expectSelector": "html.dark [data-testid=editor-canvas]" }
  ]
}
